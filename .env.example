# Copyright 2026 Davey <wgwcko@gmail.com>
# SPDX-License-Identifier: Apache-2.0
#
# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# This file is a template: key NAMES only, never values.
#
# NOTE: with `ADMIN_ENABLED=false` (the default) and no token contract set, the
# app boots in a safe, inert state. Nothing on-chain can happen by accident.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL. Must match the X OAuth redirect origin EXACTLY.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres connection string (local dev: see docker-compose.yml).
DATABASE_URL="postgresql://airdrop:airdrop@localhost:5432/airdrop"

# HMAC key for signing session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# 56 = BSC mainnet, 97 = BSC testnet (Chapel)
CHAIN_ID="97"
BSC_RPC_URL=""

# BEP-20 token contract address (set after contracts are deployed)
TOKEN_CONTRACT_ADDRESS=""

# Fixed supply minted once at deploy time. Keep in sync with the contract.
TOKEN_TOTAL_SUPPLY="8100000000"
TOKEN_DECIMALS="18"

# ---------------------------------------------------------------------------
# X (Twitter) OAuth 2.0 PKCE
# ---------------------------------------------------------------------------
# Scopes actually requested: users.read tweet.read
# (follows.read is deliberately NOT requested — see docs/01-技术方案.md §4)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# ID of the campaign post users must quote-tweet to unlock the bonus track.
CAMPAIGN_POST_ID=""

# ---------------------------------------------------------------------------
# Campaign rules
# ---------------------------------------------------------------------------
# Base amount per claim, in wei (whole tokens = value * 10^TOKEN_DECIMALS).
# Runtime value lives in the CampaignConfig table and is editable from /admin;
# this is only the seed value used on first boot.
BASE_CLAIM_AMOUNT_WEI=""

# Hard ceiling on the number of claims the system will ever accept.
MAX_TOTAL_CLAIMS="1000"

# Below this age an X account is rejected (sybil resistance).
MIN_X_ACCOUNT_AGE_DAYS="30"
MIN_X_POST_COUNT="10"

# ---------------------------------------------------------------------------
# Payout (ONLY the payout batch script reads these — never the web process)
# ---------------------------------------------------------------------------
# Path to a keystore or raw-key file, mode 0600, OUTSIDE the repository.
OPERATOR_KEYPAIR_PATH=""

# Hard ceiling on total gas this system may ever spend, in wei
# (e.g. 0.05 BNB = 50000000000000000).
MAX_GAS_SPEND_WEI="50000000000000000"

# Kill switch. When true the payout runner sends nothing.
PAYOUTS_PAUSED="true"

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Disabled by default. When false every /admin/* route returns 404.
ADMIN_ENABLED="false"

# The only address allowed to sign in to /admin (lowercase). Use a wallet that
# is SEPARATE from the payout key and holds no funds.
ADMIN_ADDRESS=""
